{
  "description": "A free, open-source design editor that runs in your browser",
  "icon": {
    "emoji": "🎨"
  },
  "secrets": [],
  "governance": {
    "preset": "two_yeses"
  },
  "tests": [
    {
      "path": "/",
      "expectText": "No designs yet"
    },
    {
      "path": "/?demo=1",
      "expectText": "Garden supper",
      "visual": true,
      "impact": [
        "web/**"
      ]
    },
    {
      "path": "/?demo=1",
      "expectSelector": "[data-layers] li"
    },
    {
      "name": "Demo poster draws an SVG icon and a star shape",
      "path": "/?demo=1",
      "expectSelector": ".art [data-el=\"d-icon\"] img[src^=\"data:image/svg+xml\"]"
    },
    {
      "name": "Library opens on its templates",
      "path": "/?demo=1#library",
      "expectText": "Garden party invitation"
    },
    {
      "name": "Library opens with no designs yet",
      "path": "/#library",
      "expectSelector": "[data-library] [data-item=\"tpl:quote-post\"] .preview > div:not(.skeleton)"
    },
    {
      "name": "Header has the File menu for export, versions and backup",
      "path": "/?demo=1",
      "expectSelector": "[data-open-file-menu]"
    },
    {
      "name": "Empty state offers opening a file",
      "path": "/",
      "expectText": "Open a file"
    },
    {
      "name": "Community gallery opens on the staging demo source",
      "path": "/?demo=1#gallery",
      "expectSelector": "[data-gallery-items]",
      "expectText": "Demo gallery",
      "visual": true,
      "id": "gallery.demo-browse",
      "impact": [
        "web/src/gallery/**",
        "web/src/io/gallery.js",
        "web/src/ui/GalleryDialog.jsx",
        "web/src/ui/App.jsx",
        "web/src/demo.js",
        "docs/gallery.md"
      ]
    },
    {
      "name": "Collaborate dialog opens from its hash route",
      "path": "/?demo=1#collaborate",
      "expectSelector": "[data-collab-choose]",
      "expectText": "Host a room"
    },
    {
      "name": "Remote storage dialog opens from its hash route",
      "path": "/?demo=1#remote",
      "expectText": "Nothing is sent anywhere until you do"
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
