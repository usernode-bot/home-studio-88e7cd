{
  "description": "A free, open-source design editor that runs in your browser",
  "icon": {
    "emoji": "🎨"
  },
  "secrets": [],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    { "path": "/", "expectText": "No designs yet" },
    { "path": "/?demo=1", "expectText": "Garden supper", "visual": true, "impact": ["web/**"] },
    { "path": "/?demo=1", "expectSelector": "[data-layers] li" },
    { "name": "Demo poster draws an SVG icon and a star shape", "path": "/?demo=1", "expectSelector": ".art [data-el=\"d-icon\"] img[src^=\"data:image/svg+xml\"]" },
    { "name": "Library opens on its templates", "path": "/?demo=1#library", "expectText": "Garden party invitation" },
    { "name": "Library opens with no designs yet", "path": "/#library", "expectSelector": "[data-library] [data-item=\"tpl:quote-post\"] .preview > div:not(.skeleton)" }
  ]
}
